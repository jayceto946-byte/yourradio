# API keys
LLM_PROVIDER=openai_compatible
LLM_API_URL=https://api.example.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_model_name_here
LASTFM_API_KEY=your_lastfm_api_key_here

# Optional local cache locations
YOURRADIO_AI_CACHE_ROOT=C:\path\to\yourradio-cache
HF_HOME=C:\path\to\yourradio-cache\huggingface
HUGGINGFACE_HUB_CACHE=C:\path\to\yourradio-cache\huggingface\hub
TRANSFORMERS_CACHE=C:\path\to\yourradio-cache\huggingface\transformers
PIP_CACHE_DIR=C:\path\to\yourradio-cache\pip
YOURRADIO_SOX_DIR=C:\path\to\sox\bin

# Debug routes are disabled by default in public installs.
ENABLE_DEBUG_ROUTES=false

WIKI_SEARCH_ENABLED=true
WIKI_USER_AGENT=YourRadio/0.1.0 (local personal project)
WIKI_MAX_LATENCY_MS=2500
WIKI_CACHE_TTL_DAYS=30

# TTS provider options: none | qwen3_custom_voice | http_compatible
TTS_PROVIDER=qwen3_custom_voice
# For a custom OpenAI-style/local HTTP TTS bridge, set TTS_PROVIDER=http_compatible
# and expose POST /tts-like JSON semantics at TTS_API_URL.
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_LANGUAGE=zh-CN
TTS_TIMEOUT_MS=120000

QWEN3_TTS_BASE_URL=http://127.0.0.1:8010
QWEN3_TTS_PYTHON_PATH=C:\path\to\qwen3-tts-env\Scripts\python.exe
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN3_TTS_DEVICE=cuda
QWEN3_TTS_DTYPE=float32
QWEN3_TTS_SPEAKER=Serena
QWEN3_TTS_LANGUAGE=Chinese
QWEN3_TTS_INSTRUCT=更像深夜电台主持人，声音放松、贴近麦克风，语速慢，情绪稳定，声音慵懒，不要夸张。
QWEN3_TTS_TIMEOUT_MS=300000

TTS_PRELOAD_BUDGET_MS=300000
TTS_CACHE_DIR=data/tts-cache
TTS_FALLBACK_PROVIDER=none
TTS_CACHE_MAX_AGE_DAYS=7
TTS_CACHE_MAX_SIZE_MB=1024
TTS_CACHE_CLEANUP_INTERVAL_SEC=3600

QWEN3_TTS_POSTPROCESS_SCRIPT=C:\path\to\dj_voice_process.py
QWEN3_TTS_POSTPROCESS_ENABLED=true
MUSIC_BITRATE=999

# Hourly chime / 整点报时
HOURLY_CHIME_WEATHER_LOCATION=YourCity
HOURLY_CHIME_DISPLAY_LOCATION=你的城市
HOURLY_CHIME_TIME_ZONE=Asia/Shanghai
HOURLY_CHIME_TTS_TIMEOUT_MS=120000
HOURLY_CHIME_TTS_BUDGET_MS=120000
HOURLY_CHIME_LLM_TIMEOUT_MS=8000
HOURLY_CHIME_WEATHER_TIMEOUT_MS=5000
HOURLY_CHIME_LATITUDE=0
HOURLY_CHIME_LONGITUDE=0
