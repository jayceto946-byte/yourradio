{
  "name": "local-ai-radio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/kill-port.js 3100 && node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3100",
    "dev:3000": "node scripts/kill-port.js 3000 && node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3000",
    "dev:clean": "node scripts/kill-port.js 3000 && node scripts/kill-port.js 3100 && node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "test:tts:qwen3": "node scripts/test-qwen3-tts-performance.js",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-yourradio.ps1",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-yourradio-clean.ps1",
    "import:playlist": "node scripts/import-playlist.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "next": "^15.3.1",
    "opencc-js": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "typescript": "^5.8.3"
  }
}
